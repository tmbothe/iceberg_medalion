{
  "Comment": "Manufacturing Lakehouse ETL Pipeline. Default: incremental load. Override by passing any key in execution input.",
  "StartAt": "SetDefaults",
  "States": {
    "SetDefaults": {
      "Type": "Pass",
      "Comment": "Merges hardcoded defaults with execution input. Keys in execution input override defaults.",
      "Parameters": {
        "params.$": "States.JsonMerge(States.StringToJson('{\"load_batch\":\"data_2\",\"load_type\":\"incremental\",\"report_date\":\"2024-02-02\",\"bucket_name\":\"mfg-lakehouse-442042510197-us-east-1\"}'), $, false)"
      },
      "Next": "ExtractParams"
    },
    "ExtractParams": {
      "Type": "Pass",
      "Comment": "Flattens params to top-level keys for downstream states.",
      "Parameters": {
        "load_batch.$": "$.params.load_batch",
        "load_type.$":  "$.params.load_type",
        "report_date.$": "$.params.report_date",
        "bucket_name.$": "$.params.bucket_name"
      },
      "Next": "BronzeIngestion"
    },
    "BronzeIngestion": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "BronzeOperator",
          "States": {
            "BronzeOperator": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "mfg-raw-to-bronze-operator",
                "Arguments": {
                  "--LOAD_BATCH.$": "$.load_batch",
                  "--BUCKET_NAME.$": "$.bucket_name"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "BronzeMachine",
          "States": {
            "BronzeMachine": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "mfg-raw-to-bronze-machine",
                "Arguments": {
                  "--LOAD_BATCH.$": "$.load_batch",
                  "--BUCKET_NAME.$": "$.bucket_name"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "BronzeMaterial",
          "States": {
            "BronzeMaterial": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "mfg-raw-to-bronze-material",
                "Arguments": {
                  "--LOAD_BATCH.$": "$.load_batch",
                  "--BUCKET_NAME.$": "$.bucket_name"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "BronzeSupplier",
          "States": {
            "BronzeSupplier": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "mfg-raw-to-bronze-supplier",
                "Arguments": {
                  "--LOAD_BATCH.$": "$.load_batch",
                  "--BUCKET_NAME.$": "$.bucket_name"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "BronzeOplog",
          "States": {
            "BronzeOplog": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "mfg-raw-to-bronze-oplog",
                "Arguments": {
                  "--LOAD_BATCH.$": "$.load_batch",
                  "--BUCKET_NAME.$": "$.bucket_name"
                }
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": null,
      "Next": "SilverTransformation"
    },
    "SilverTransformation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "mfg-bronze-to-silver",
        "Arguments": {
          "--LOAD_BATCH.$": "$.load_batch",
          "--LOAD_TYPE.$": "$.load_type",
          "--BUCKET_NAME.$": "$.bucket_name"
        }
      },
      "ResultPath": null,
      "Next": "GoldAggregation"
    },
    "GoldAggregation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "mfg-silver-to-gold",
        "Arguments": {
          "--REPORT_DATE.$": "$.report_date",
          "--BUCKET_NAME.$": "$.bucket_name"
        }
      },
      "End": true
    }
  }
}
